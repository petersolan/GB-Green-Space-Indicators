# Where the lake lives: local (folder ./lake), azurite (emulator) or azure (real account)
LAKE_BACKEND=local
LAKE_CONTAINER=lake

# For LAKE_BACKEND=azure, either a connection string ...
# AZURE_STORAGE_CONNECTION_STRING=
# ... or an account name and key
# AZURE_STORAGE_ACCOUNT_NAME=
# AZURE_STORAGE_ACCOUNT_KEY=

# Inputs from the companion projects (defaults are sibling folders)
# CENSUS_DIR=../Census-distribution/data/processed
# ZOOMSTACK_GPKG=../Census-distribution/data/footprints/OS_Open_Zoomstack.gpkg
